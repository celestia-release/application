#
# Makefile for application/packages/ipcamera (headless device-type shell)
#
include $(COMPILATION_RULES)
FRAMEWORK_OR_PROJECT := $(or $(FRAMEWORK_CONFIG_FILE),$(PROJECT_CONFIG_FILE))
include $(FRAMEWORK_OR_PROJECT)

MODULE_ROOT ?= $(shell pwd)

.PHONY: all clean install

all:
	@mkdir -p "$(BUILD_DIR)"
ifeq ($(CONFIG_APP_PACKAGES_IPCAMERA),y)
ifneq ($(CONFIG_APP_IPCAMERA_IPC_CAM),n)
	$(MAKE) -C $(MODULE_ROOT)/ipc_cam \
		SRC_APPLICATION_DIR=$(SRC_APPLICATION_DIR) \
		BUILD_DIR=$(BUILD_APPLICATION_DIR)/packages/ipcamera/ipc_cam \
		BUILD_APPLICATION_DIR=$(BUILD_APPLICATION_DIR) \
		ROOTFS_DIR=$(ROOTFS_DIR) \
		APPLICATION_INSTALL_DIR=$(APPLICATION_INSTALL_DIR) \
		FRAMEWORK_INSTALL_DIR=$(FRAMEWORK_INSTALL_DIR) \
		SYSTEM_CORE_INSTALL_DIR=$(SYSTEM_CORE_INSTALL_DIR) \
		HARDWARE_INSTALL_DIR=$(HARDWARE_INSTALL_DIR) \
		THIRD_PARTY_INSTALL_DIR=$(THIRD_PARTY_INSTALL_DIR) \
		PROJECT_CONFIG_FILE=$(FRAMEWORK_OR_PROJECT) \
		FRAMEWORK_CONFIG_FILE=$(FRAMEWORK_OR_PROJECT) \
		COMPILATION_RULES=$(COMPILATION_RULES) \
		all install
endif
ifeq ($(CONFIG_APP_IPCAMERA_MIKE_CAM),y)
	$(MAKE) -C $(MODULE_ROOT)/mike_cam \
		SRC_APPLICATION_DIR=$(SRC_APPLICATION_DIR) \
		BUILD_DIR=$(BUILD_APPLICATION_DIR)/packages/ipcamera/mike_cam \
		BUILD_APPLICATION_DIR=$(BUILD_APPLICATION_DIR) \
		ROOTFS_DIR=$(ROOTFS_DIR) \
		APPLICATION_INSTALL_DIR=$(APPLICATION_INSTALL_DIR) \
		FRAMEWORK_INSTALL_DIR=$(FRAMEWORK_INSTALL_DIR) \
		SYSTEM_CORE_INSTALL_DIR=$(SYSTEM_CORE_INSTALL_DIR) \
		HARDWARE_INSTALL_DIR=$(HARDWARE_INSTALL_DIR) \
		THIRD_PARTY_INSTALL_DIR=$(THIRD_PARTY_INSTALL_DIR) \
		PROJECT_CONFIG_FILE=$(FRAMEWORK_OR_PROJECT) \
		FRAMEWORK_CONFIG_FILE=$(FRAMEWORK_OR_PROJECT) \
		COMPILATION_RULES=$(COMPILATION_RULES) \
		all install
endif
else
	@echo "packages/ipcamera: skipped (CONFIG_APP_PACKAGES_IPCAMERA!=y)"
endif

install: all

clean:
ifeq ($(CONFIG_APP_PACKAGES_IPCAMERA),y)
	$(MAKE) -C $(MODULE_ROOT)/ipc_cam clean BUILD_DIR=$(BUILD_APPLICATION_DIR)/packages/ipcamera/ipc_cam || true
	$(MAKE) -C $(MODULE_ROOT)/mike_cam clean BUILD_DIR=$(BUILD_APPLICATION_DIR)/packages/ipcamera/mike_cam || true
endif
	@rm -rf "$(BUILD_DIR)"
